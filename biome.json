{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": ["*.ts", "*.json"]
  },
  "formatter": { "enabled": true, "indentStyle": "space" },
  "linter": {
    "enabled": true,
    "rules": {
      "style": { "noNonNullAssertion": "off" },
      "suspicious": {
        "noExplicitAny": "off",
        "useAwait": "error"
      },
      "complexity": { "useOptionalChain": "error" }
    }
  }
}
